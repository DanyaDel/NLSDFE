#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform writeonly image2D resultImage;
layout(binding = 2) uniform writeonly image2D sdfDepthImage;

layout(push_constant) uniform PushConsts {
    mat4 camToWorld;
    vec2 resolution;
    float time;
    int draggingAxis;
    int objectCount;
    int selectedIndex;
    int mode; // 0=Move, 1=Rotate, 2=Scale
    float uiMinX, uiMinY, uiMaxX, uiMaxY;
    int shadingMode; // 0=Wire, 1=Solid, 2=Material, 3=Rendered
    vec3 gizmoPos;   // Центр выделения (передается из CPU)
    float focalLength; // FOV sync
} pc;

struct Object {
    mat4 invRotation; 
    vec4 position;    
    vec4 scale;       
    vec4 params;      
    vec4 color;       
    vec4 rotationEuler; 
};

layout(std430, binding = 1) readonly buffer ObjectBuffer {
    Object objects[];
} scene;

// =================================================================
// --- Utilities ---
// =================================================================
float rand(vec2 xy) {
    return fract(tan(distance(xy * 1.61803398874989484820459, xy) * pc.time) * xy.x);
}

// =================================================================
// --- SDF Primitives ---
// =================================================================
float sdSphere(vec3 p, float s) { return length(p) - s; }
float sdBox(vec3 p, vec3 b) { 
    vec3 q = abs(p) - b; 
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0); 
}
float sdCylinder(vec3 p, float h, float r) {
  vec2 d = abs(vec2(length(p.xz),p.y)) - vec2(r,h);
  return min(max(d.x,d.y),0.0) + length(max(d,0.0));
}
float sdCone(vec3 p, float h, float r1, float r2) {
    vec2 q = vec2( length(p.xz), p.y );
    vec2 k1 = vec2(r2,h);
    vec2 k2 = vec2(r2-r1,2.0*h);
    vec2 ca = vec2(q.x-min(q.x,(q.y < 0.0)?r1:r2), abs(q.y)-h);
    vec2 cb = q - k1 + k2*clamp( dot(k1-q,k2)/dot(k2,k2), 0.0, 1.0 );
    float s = (cb.x < 0.0 && ca.y < 0.0) ? -1.0 : 1.0;
    return s*sqrt( min(dot(ca,ca),dot(cb,cb)) );
}
float sdRingX(vec3 p, float r, float th) { return length(vec2(length(p.yz) - r, p.x)) - th; }
float sdRingY(vec3 p, float r, float th) { return length(vec2(length(p.xz) - r, p.y)) - th; }
float sdRingZ(vec3 p, float r, float th) { return length(vec2(length(p.xy) - r, p.z)) - th; }

// =================================================================
// --- CSG Operations ---
// =================================================================
vec2 opSmoothUnion(vec2 d1, vec2 d2, float k) {
    float h = clamp(0.5 + 0.5 * (d2.x - d1.x) / k, 0.0, 1.0);
    return vec2(mix(d2.x, d1.x, h) - k * h * (1.0 - h), (d1.x < d2.x) ? d1.y : d2.y);
}
vec2 opSmoothSub(vec2 d1, vec2 d2, float k) {
    float h = clamp(0.5 - 0.5 * (d2.x + d1.x) / k, 0.0, 1.0);
    return vec2(mix(d2.x, -d1.x, h) + k * h * (1.0 - h), d2.y);
}
vec2 opSmoothIntersect(vec2 d1, vec2 d2, float k) {
    float h = clamp(0.5 - 0.5 * (d2.x - d1.x) / k, 0.0, 1.0);
    return vec2(mix(d2.x, d1.x, h) + k * h * (1.0 - h), (d1.x > d2.x) ? d1.y : d2.y);
}

// =================================================================
// --- Scene Logic ---
// =================================================================
vec2 mapScene(vec3 p) {
    vec2 globalRes = vec2(100.0, -1.0);
    for(int i = 0; i < pc.objectCount; i++) {
        vec3 pos = scene.objects[i].position.xyz;
        vec3 rawScl = scene.objects[i].scale.xyz;
        vec3 absScl = abs(rawScl);
        float size = scene.objects[i].params.x;
        int type = int(scene.objects[i].position.w);
        if (type < 0) continue; // Skip meshes in SDF raymarching

        int op = int(scene.objects[i].params.y);
        float smoothK = max(scene.objects[i].params.z, 0.001);

        vec3 localP = p - pos;
        localP = (scene.objects[i].invRotation * vec4(localP, 1.0)).xyz;

        float d = 0.0;
        if (type == 0) { // Sphere
            float minScale = min(absScl.x, min(absScl.y, absScl.z));
            d = sdSphere(localP / rawScl, size) * minScale; 
        } 
        else if (type == 1) { // Box
            d = sdBox(localP, vec3(size) * absScl);
        }

        vec2 currentObj = vec2(d, float(i));
        if (i == 0) globalRes = currentObj;
        else {
            if (op == 0) globalRes = opSmoothUnion(globalRes, currentObj, smoothK); 
            else if (op == 1) globalRes = opSmoothSub(currentObj, globalRes, smoothK);
            else if (op == 2) globalRes = opSmoothIntersect(globalRes, currentObj, smoothK); 
        }
    }
    return globalRes;
}

vec3 getNormal(vec3 p, float t) {
    float eps = 0.0005 * t; 
    vec2 k = vec2(1.0, -1.0);
    return normalize(
        k.xyy * mapScene(p + k.xyy * eps).x + 
        k.yyx * mapScene(p + k.yyx * eps).x + 
        k.yxy * mapScene(p + k.yxy * eps).x + 
        k.xxx * mapScene(p + k.xxx * eps).x
    );
}

float calcAO(vec3 p, vec3 n) {
    float occ = 0.0; float sca = 1.0;
    for(int i = 0; i < 3; i++) {
        float h = 0.02 + 0.15 * float(i) / 2.0;
        float d = mapScene(p + n * h).x;
        occ += (h - d) * sca; sca *= 0.8;
    }
    return clamp(1.0 - 2.5 * occ, 0.0, 1.0);
}

float calcSoftShadow(vec3 ro, vec3 rd, float tmin, float tmax, float k) {
    float res = 1.0; 
    float t = tmin + (rand(gl_GlobalInvocationID.xy) * 0.02); 
    float ph = 1e10;
    for(int i=0; i<16; i++) {
        float h = mapScene(ro + rd*t).x;
        float y = h*h/(2.0*ph);
        float d = sqrt(h*h-y*y);
        res = min(res, k*d/max(0.0, t-y));
        ph = h; 
        t += clamp(h, 0.02, 0.5);
        if(res < 0.005 || t > tmax) break;
    }
    return clamp(res, 0.0, 1.0);
}

float calcHardShadow(vec3 ro, vec3 rd, float tmax) {
    float t = 0.05;
    for(int i=0; i<32; i++) {
        float h = mapScene(ro + rd*t).x;
        if(h < 0.001) return 0.0;
        t += h;
        if(t > tmax) break;
    }
    return 1.0;
}

// PBR Functions
float DistributionGGX(vec3 N, vec3 H, float roughness) {
    float a = roughness*roughness; float a2 = a*a;
    float NdotH = max(dot(N, H), 0.0); float NdotH2 = NdotH*NdotH;
    float num = a2; float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    return num / (3.14159 * denom * denom + 0.0001);
}
float GeometrySchlickGGX(float NdotV, float roughness) {
    float r = (roughness + 1.0); float k = (r*r) / 8.0;
    return NdotV / (NdotV * (1.0 - k) + k);
}
float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
    return GeometrySchlickGGX(max(dot(N, V), 0.0), roughness) * GeometrySchlickGGX(max(dot(N, L), 0.0), roughness);
}
vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}
vec3 calculatePBR(vec3 n, vec3 v, vec3 lightDir, vec3 albedo, float metallic, float roughness) {
    vec3 h = normalize(v + lightDir);
    float NdotL = max(dot(n, lightDir), 0.0);
    vec3 F0 = mix(vec3(0.04), albedo, metallic);
    vec3 F = fresnelSchlick(max(dot(h, v), 0.0), F0);
    float NDF = DistributionGGX(n, h, roughness);   
    float G = GeometrySmith(n, v, lightDir, roughness);    
    vec3 num = NDF * G * F;
    float denom = 4.0 * max(dot(n, v), 0.0) * NdotL + 0.001;
    vec3 specular = num / denom;
    vec3 kD = (vec3(1.0) - F) * (1.0 - metallic);
    return (kD * albedo / 3.14159 + specular) * NdotL * 2.8;
}

// =================================================================
// --- Gizmo & Guide Definitions ---
// =================================================================

float sdArrow(vec3 p, float totalLen, float thick, float headLen, float headW) {
    float bodyLen = totalLen - headLen;
    float body = sdCylinder(p - vec3(0, bodyLen*0.5, 0), bodyLen*0.5, thick);
    float head = sdCone(p - vec3(0, bodyLen + headLen*0.5, 0), headLen*0.5, headW, 0.0);
    return min(body, head);
}

float sdScaleHandle(vec3 p, float totalLen, float thick, float cubeSize) {
    float bodyLen = totalLen - cubeSize;
    float body = sdCylinder(p - vec3(0, bodyLen*0.5, 0), bodyLen*0.5, thick);
    float head = sdBox(p - vec3(0, bodyLen + cubeSize*0.5, 0), vec3(cubeSize*0.5));
    return min(body, head);
}

vec2 mapGizmo(vec3 p, vec3 ro) {
    if (pc.selectedIndex < 0) return vec2(100.0, 0.0);
    
    // Используем переданный центр выделения, а не позицию отдельного объекта
    vec3 center = pc.gizmoPos;
    
    float scale = length(ro - center) * 0.12; 
    vec3 loc = p - center;
    float minD = 10000.0; float axis = 0.0;
    
    if (pc.mode == 0) { // Move
        float len = 1.3*scale; float th = 0.02*scale; float hL = 0.3*scale; float hW = 0.08*scale;
        float dX = sdArrow(vec3(loc.y, loc.x, loc.z), len, th, hL, hW);
        float dY = sdArrow(loc, len, th, hL, hW);
        float dZ = sdArrow(vec3(loc.y, loc.z, loc.x), len, th, hL, hW);
        // Центральный шар для перемещения во всех осях
        float dC = length(loc) - 0.25*scale;
        
        minD = dX; axis = 1.0;
        if (dY < minD) { minD = dY; axis = 2.0; }
        if (dZ < minD) { minD = dZ; axis = 3.0; }
        if (dC < minD) { minD = dC; axis = 4.0; } // 4.0 = Center Axis
    } else if (pc.mode == 1) { // Rotate
        float r = 1.0 * scale; float th = 0.02 * scale;
        float dX = sdRingX(loc, r, th); float dY = sdRingZ(loc, r, th); float dZ = sdRingY(loc, r, th); 
        minD = dX; axis = 1.0;
        if (dY < minD) { minD = dY; axis = 2.0; }
        if (dZ < minD) { minD = dZ; axis = 3.0; }
    } else if (pc.mode == 2) { // Scale
        float len = 1.3*scale; float th = 0.02*scale; float cubeS = 0.15*scale;
        float dX = sdScaleHandle(vec3(loc.y, loc.x, loc.z), len, th, cubeS);
        float dY = sdScaleHandle(loc, len, th, cubeS);
        float dZ = sdScaleHandle(vec3(loc.y, loc.z, loc.x), len, th, cubeS);
        float dC = length(loc) - 0.2*scale; 
        minD = dX; axis = 1.0;
        if (dY < minD) { minD = dY; axis = 2.0; }
        if (dZ < minD) { minD = dZ; axis = 3.0; }
        if (dC < minD) { minD = dC; axis = 4.0; }
    }
    return vec2(minD, axis);
}

// SDF для бесконечной линии
float mapGuideLine(vec3 p, vec3 center, int axis, float scale) {
    vec3 q = p - center; 
    // Делаем линию очень тонкой (0.005)
    float thick = 0.005 * scale; 
    
    // Формула расстояния до бесконечной линии вдоль оси
    if (axis == 1) return length(q.yz) - thick; // Линия вдоль X
    if (axis == 2) return length(q.xz) - thick; // Линия вдоль Y
    if (axis == 3) return length(q.xy) - thick; // Линия вдоль Z
    return 1000.0;
}

void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    
    // UI Culling (не рисуем под интерфейсом)
    if (float(texelCoord.x) >= pc.uiMinX && float(texelCoord.x) <= pc.uiMaxX &&
        float(texelCoord.y) >= pc.uiMinY && float(texelCoord.y) <= pc.uiMaxY) {
        imageStore(resultImage, texelCoord, vec4(0.1, 0.1, 0.1, 1.0)); 
        return;
    }

    if(texelCoord.x >= pc.resolution.x || texelCoord.y >= pc.resolution.y) return;

    vec2 uv = (vec2(texelCoord) * 2.0 - pc.resolution) / pc.resolution.y;
    uv.y = -uv.y;

    vec3 ro = pc.camToWorld[3].xyz;
    vec3 rd = mat3(pc.camToWorld) * normalize(vec3(uv, -pc.focalLength));

    // Авто-оптимизация: Если двигаем гизмо, принудительно включаем режим Solid (быстрее)
    int effMode = pc.shadingMode;
    if (pc.draggingAxis > 0) effMode = 1;

    vec3 finalColor = vec3(0.0);
    vec3 throughput = vec3(1.0);
    float firstHitT = -1.0;
    
    int maxBounces = (effMode == 3) ? 2 : 1; 
    if (effMode == 0) maxBounces = 1;

    // --- Рендеринг сцены ---
    for(int bounce = 0; bounce < maxBounces; bounce++) {
        float t = 0.1; float tMax = 50.0;
        float pixelRadius = 1.0 / (pc.resolution.y * 0.5);
        float objID = -1.0; bool hit = false;
        
        int stepsTaken = 0;
        for(int i=0; i<32; i++) {
            stepsTaken++;
            vec3 p = ro + rd * t;
            vec2 res = mapScene(p);
            float d = res.x;
            if (abs(d) < (pixelRadius * t)) { 
                hit = true; objID = res.y; 
                if(bounce == 0) firstHitT = t;
                break; 
            }
            if (t > tMax) break;
            t += d;
        }
        
        // WIREFRAME / HEATMAP
        if (effMode == 0) {
            if (hit) {
                float heat = float(stepsTaken) / 60.0;
                vec3 col = mix(vec3(0.1, 0.8, 0.2), vec3(0.9, 0.1, 0.1), clamp(heat, 0.0, 1.0));
                vec3 p = ro + rd * t;
                vec3 n = getNormal(p, t);
                float edge = 1.0 - abs(dot(n, -rd));
                col = mix(col, vec3(1.0), pow(edge, 4.0));
                finalColor = col;
            } else {
                finalColor = vec3(0.15); 
            }
            break; 
        }

        // Освещение
        if (hit) {
            vec3 p = ro + rd * (t - pixelRadius * t * 0.5);
            vec3 n = getNormal(p, t);
            vec3 albedo = vec3(0.8); float metallic = 0.0; float roughness = 0.5;
            
            if (objID >= 0.0) {
                int id = int(objID);
                albedo = scene.objects[id].color.rgb;
                roughness = scene.objects[id].color.w;
                metallic = scene.objects[id].params.w;
                // Подсветка выделения
                if (id == pc.selectedIndex) albedo = mix(albedo, vec3(1.0), 0.2);
            }
            
            vec3 lightDir = normalize(vec3(0.5, 0.8, -0.5));
            vec3 viewDir = -rd;

            // SOLID MODE
            if (effMode == 1) {
                float NdotL = max(dot(n, lightDir), 0.0);
                float shadow = 1.0;
                if (NdotL > 0.0) shadow = calcHardShadow(p + n*0.05, lightDir, 10.0);
                
                vec3 ambient = albedo * 0.2;
                vec3 diffuse = albedo * NdotL * shadow;
                finalColor = ambient + diffuse;
                break; 
            }

            // PBR
            vec3 directLight = calculatePBR(n, viewDir, lightDir, albedo, metallic, roughness);
            float NdotL = dot(n, lightDir);
            
            if (NdotL > 0.0) {
                float shadowSteps = (effMode == 3) ? 16.0 : 8.0;
                float sh = calcSoftShadow(p + n*0.05, lightDir, 0.05, 10.0, shadowSteps); 
                directLight *= sh;
            } else directLight *= 0.0; 
            
            float ao = calcAO(p, n);
            vec3 ambient = (0.03 * albedo) * ao;
            finalColor += throughput * (directLight + ambient);
            
            if (effMode == 2) break; 

            // Отражения (только в режиме Rendered)
            if (roughness > 0.6 || bounce >= maxBounces - 1) break;
            
            vec3 F0 = mix(vec3(0.04), albedo, metallic);
            vec3 F = fresnelSchlick(max(dot(n, viewDir), 0.0), F0);
            throughput *= F; 
            
            ro = p + n * 0.05; 
            rd = reflect(rd, n);

        } else {
            // Skybox
            vec3 skyCol = vec3(0.15, 0.15, 0.2);
            skyCol = mix(skyCol, vec3(0.05, 0.05, 0.1), rd.y * 0.5 + 0.5);
            if (bounce == 0 && ro.y > 0.0 && rd.y < 0.0) {
                float tp = -ro.y / rd.y; vec3 pp = ro + rd * tp;
                float g = step(0.98, fract(pp.x)) + step(0.98, fract(pp.z));
                if (g > 0.5) skyCol = mix(skyCol, vec3(0.3), 0.5 * exp(-tp*0.02));
            }
            finalColor += throughput * skyCol;
            break;
        }
    }
    
    // Tone Mapping
    finalColor = finalColor / (finalColor + vec3(1.0));
    finalColor = pow(finalColor, vec3(1.0/2.2));

    // --- ОТРИСОВКА ГИЗМО (Поверх всего / X-Ray) ---
    if (pc.selectedIndex >= 0) {
        vec3 center = pc.gizmoPos; // Берем центр, рассчитанный в main.cpp
        vec3 gRo = pc.camToWorld[3].xyz;
        vec3 gRd = mat3(pc.camToWorld) * normalize(vec3(uv, -pc.focalLength));
        float centerDist = length(center - gRo);
        
        // Начинаем луч от 0.1, чтобы рисовать поверх геометрии сцены
        float tG = 0.1; 
        
        // Увеличили количество шагов, чтобы линия не обрывалась
        for(int i=0; i<80; i++) {
            vec3 p = gRo + gRd * tG;
            vec2 res = mapGizmo(p, gRo);
            float lineD = 10000.0;

            // Если тянем ось (1=X, 2=Y, 3=Z), рисуем направляющую линию
            if (pc.mode == 0 && pc.draggingAxis >= 1 && pc.draggingAxis <= 3) {
                 float scale = centerDist * 0.12;
                 lineD = mapGuideLine(p, center, pc.draggingAxis, scale);
            }
            
            // Попадание в Гизмо
            if (res.x < 0.003 * tG) { 
                vec3 axisCol = vec3(1.0);
                if (res.y == 1.0) axisCol = vec3(0.9, 0.2, 0.2); // Red X
                if (res.y == 2.0) axisCol = vec3(0.2, 0.9, 0.2); // Green Y
                if (res.y == 3.0) axisCol = vec3(0.2, 0.2, 0.9); // Blue Z
                if (res.y == 4.0) axisCol = vec3(1.0, 1.0, 1.0); // White Center
                finalColor = axisCol; 
                break;
            }
            // Попадание в направляющую линию
            if (lineD < 0.003 * tG) {
                vec3 lineCol = vec3(1.0);
                if (pc.draggingAxis == 1) lineCol = vec3(0.9, 0.2, 0.2);
                if (pc.draggingAxis == 2) lineCol = vec3(0.2, 0.9, 0.2);
                if (pc.draggingAxis == 3) lineCol = vec3(0.2, 0.2, 0.9);
                finalColor = lineCol; 
                break;
            }
            
            tG += max(min(abs(res.x), abs(lineD)), 0.01);
            // Ограничиваем дальность, чтобы не считать вечно
            if (tG > centerDist + 50.0) break;
        }
    }

    imageStore(resultImage, texelCoord, vec4(finalColor, 1.0));

    float depthOut = 1.0;
    if (firstHitT > 0.0) {
        float nearP = 0.1;
        float farP = 200.0;
        depthOut = farP / (farP - nearP) + (farP * nearP) / (firstHitT * (nearP - farP));
    }
    imageStore(sdfDepthImage, texelCoord, vec4(depthOut, 0.0, 0.0, 0.0));
}